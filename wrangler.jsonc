{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 新站点：改 name、routes、database_name/id、bucket_name、queue 名称，再改 src/config/site.ts
  "name": "ai-rap-video-maynor",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "staging",
    "SITE_URL": "https://ai-rap-video-maynor.chatgpt-plus.workers.dev",
    // waffo | dodo | stripe | mock（mock 只允许非 production）
    "PAYMENT_PROVIDER": "stripe",
    // yir（首选）| tryallapi | mock（仅本地/e2e，staging/production 禁止）
    "VIDEO_PROVIDER": "yir",
    // 主服务商提交失败（账户/不可用，非用户输入校验）且尚未拿到 request id 时，自动改用回退服务商重试一次
    "VIDEO_FALLBACK_PROVIDER": "tryallapi",
    // 管理员邮箱（逗号分隔）：登录即为管理员，同时接收举报、留言提醒和系统告警
    "ADMIN_EMAILS": "bgnwd15@gmail.com",
    // 交易邮件发件地址，域名须在 Cloudflare Email Service 完成 Onboard；留空 = 不发信（后台“邮件”页记为 skipped）
    "EMAIL_FROM": "noreply@ai-rap-video.asia",
    "WAFFO_ENVIRONMENT": "test",
    // Waffo 店铺 ID（STO_xxx，公开）：订阅的客户门户要用；只卖积分包可以留空
    "WAFFO_STORE_ID": "",
    "DODO_ENVIRONMENT": "test",
    // 每个积分包、订阅套餐对应支付商的 product id（JSON：{"starter":"PROD_xxx","monthly":"PROD_yyy",...}）
    "WAFFO_PRODUCTS": "{}",
    "DODO_PRODUCTS": "{}",
    // Stripe Price id（price_xxx），与积分包/订阅套餐 id 对应
    "STRIPE_PRODUCTS": "{}",
    // test | live（与密钥 sk_test_/sk_live_ 一致；production 下 test 会告警）
    "STRIPE_ENVIRONMENT": "test",
    "GOOGLE_CLIENT_ID": "",
    // Cloudflare Turnstile 站点密钥（公开）；留空 = 不启用。启用时必须同时 `wrangler secret put TURNSTILE_SECRET_KEY`
    "TURNSTILE_SITE_KEY": "",
    // 上传图片审核：openai（需 OPENAI_API_KEY）| none | mock（mock 只允许非 production）
    "MODERATION_PROVIDER": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Free-plan D1 create quota full (max 11): reuse existing hallowpaws-db.
      // All tables/indexes prefixed `arv_`; wrangler ledger `arv_d1_migrations` (cf. skills-hub `skh_`).
      // (maynorai-research-db was at daily row-read limit during migrate, so hallowpaws-db was chosen.)
      "database_name": "hallowpaws-db",
      "database_id": "f50e915e-e0cb-4b37-8237-42690399978d",
      "migrations_dir": "migrations",
      "migrations_table": "arv_d1_migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ai-rap-video-maynor-media" }],
  "kv_namespaces": [{ "binding": "KV", "id": "41cad96aafcd459f829d25aea25ed784" }],
  "queues": {
    "producers": [{ "binding": "VIDEO_QUEUE", "queue": "ai-rap-video-maynor-jobs" }],
    "consumers": [
      {
        "queue": "ai-rap-video-maynor-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "dead_letter_queue": "ai-rap-video-maynor-jobs-dlq"
      },
      // 死信：同一个 Worker 消费，任务判失败、退积分，健康检查据此告警（src/server.ts 按 -dlq 后缀分流）
      { "queue": "ai-rap-video-maynor-jobs-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "4211", "simple": { "limit": 20, "period": 60 } },
    { "name": "GENERATE_LIMITER", "namespace_id": "4212", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "4213", "simple": { "limit": 30, "period": 60 } }
  ],
  // Cloudflare Email Service（交易邮件、管理员提醒）。本地 dev / e2e 只模拟发送；不要加 "remote": true，否则会真的发信
  "send_email": [{ "name": "EMAIL" }],
  // Free plan: max 5 cron triggers/account already used — skip cron on this staging Worker.
  // Retention/expiry/alerts cron will need Workers Paid or freeing another schedule.
  // "triggers": { "crons": ["*/5 * * * *"] }
  "triggers": { "crons": [] }
}
