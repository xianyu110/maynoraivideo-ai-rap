# Copy to .dev.vars for local wrangler/vite (gitignored).
# Production: never commit real values — use `npx wrangler secret put <NAME>`
# or `node scripts/sync-secrets.mjs --apply` with a local `.dev.vars.production`.
# Full list: docs/env.md | Quick path: Stripe + TryAllAPI (see README Quick start).

# Required always (openssl rand -hex 32). Placeholder refused in prod/staging.
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (with GOOGLE_CLIENT_ID in wrangler.jsonc vars)
GOOGLE_CLIENT_SECRET=

# --- Payments: set PAYMENT_PROVIDER in wrangler.jsonc ---
# Waffo Pancake
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Stripe (PAYMENT_PROVIDER=stripe) — sk_test_/sk_live_ + webhook whsec_…
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Video: VIDEO_PROVIDER=tryallapi (default) or mock (local/e2e only) ---
# TryAllAPI (VIDEO_PROVIDER=tryallapi) https://tryallapi.com/console/token
TRYALLAPI_API_KEY=
# Optional; default https://tryallapi.com
TRYALLAPI_BASE_URL=

# Image moderation (MODERATION_PROVIDER=openai)
OPENAI_API_KEY=
# Turnstile (when vars.TURNSTILE_SITE_KEY is set)
TURNSTILE_SECRET_KEY=
# Optional payment chat notify — see docs/env.md (Telegram / Feishu / Discord / Slack)
PAYMENT_NOTIFY_WEBHOOK_URL=
